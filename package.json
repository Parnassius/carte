{
  "devDependencies": {
    "@biomejs/biome": "*",
    "prettier": "*",
    "prettier-plugin-jinja-template": "*"
  },
  "prettier": {
    "plugins": ["prettier-plugin-jinja-template"],
    "htmlWhitespaceSensitivity": "ignore",
    "overrides": [
      {
        "files": ["*.html"],
        "options": {
          "parser": "jinja-template"
        }
      }
    ]
  }
}
